# MediBook — Environment Variables Template
# Copy this file to .env and fill in your own local credentials.
# The .env file is gitignored and will never be committed.

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
# Replace with your own local MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medibook

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
